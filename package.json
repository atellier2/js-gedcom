  "description": "Dependency-free JavaScript library for parsing, validating, and creating GEDCOM genealogy files",
  "type": "module",
  "main": "src/g7structure.js",
  "exports": {
    "./gedcstruct": "./src/gedcstruct.js",
    "./g7datatypes": "./src/g7datatypes.js",
    "./g7lookups": "./src/g7lookups.js",
    "./g7structure": "./src/g7structure.js"
  },
  "license": "MIT OR Unlicense",
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test":             "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit":        "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:setup":       "node tests/setup.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gedcom7code/js-gedcom"
  }
